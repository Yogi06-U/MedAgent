# ==============================================================================
# MedAgent Configuration & Environment Variables
# ==============================================================================

# Server Network Settings
HOST=127.0.0.1
PORT=8000

# LLM Provider Configuration
# Options: 'offline' (deterministic rule engine fallback), 'gemini', 'openai', 'anthropic'
LLM_PROVIDER=offline
LLM_MODEL=

# API Keys (leave blank for default offline operation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# RAG & Knowledge Vector Storage
# Options: 'numpy' (local embedded cosine store), 'pinecone' (remote serverless)
VECTOR_BACKEND=numpy
PINECONE_API_KEY=
PINECONE_INDEX=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Imaging Agent Settings (TorchXRayVision)
TORCHXRAYVISION_WEIGHTS=densenet121-res224-all
ENABLE_MEDGEMMA=false
MEDGEMMA_MODEL_ID=google/medgemma-4b-it

# Speech / Voice Dictation Model
WHISPER_MODEL=tiny

# System & Data Storage Paths
DATA_DIR=data
DB_PATH=medagent.db
REPORTS_DIR=reports
UPLOAD_DIR=uploads
